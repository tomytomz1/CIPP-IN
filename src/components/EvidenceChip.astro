---
/**
 * Inline evidence label (Verified / Inference / Not established), the compact form of
 * EvidenceNote. The text is always visible; the icon and color only reinforce it.
 */
interface Props {
  kind: 'fact' | 'inference' | 'unverified';
}
const { kind } = Astro.props;
const labels = { fact: 'Verified', inference: 'Inference', unverified: 'Not established' } as const;
---

<span class={`chip chip--${kind}`}>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {kind === 'fact' && <path d="M3.5 8.4 L6.6 11.3 L12.5 4.8" />}
    {kind === 'inference' && <path d="M3 4.5 H8 M3 11.5 H8 M8 4.5 Q10 4.5 10.5 8 Q11 11.5 13 11.5 M10.5 8 H13" />}
    {kind === 'unverified' && <path d="M5.8 5.9 Q6 3.6 8.1 3.6 Q10.3 3.6 10.3 5.6 Q10.3 7.2 8.1 8.2 V9.6 M8.1 12.2 V12.4" />}
  </svg>
  {labels[kind]}
</span>
