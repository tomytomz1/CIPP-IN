---
/**
 * On-page source list. Every entry mirrors a record in research/sources/*.json: title,
 * publisher, the date we verified it, and the limitation that applies to it
 * (docs/04 → Source Hierarchy: record URL, publisher, date accessed, and the claim supported).
 */
import type { Source } from '../lib/content/sources.ts';

interface Props {
  sources: readonly Source[];
}

const { sources } = Astro.props;
---

<ol class="sources">
  {
    sources.map((s) => (
      <li id={`source-${s.id}`}>
        {s.url ? <a href={s.url} rel="nofollow noopener">{s.title}</a> : s.title} — {s.publisher}.
        <span class="subtle">
          Supports: {s.supports} Verified {s.verifiedAt}.{s.limitation ? ` Limitation: ${s.limitation}` : ''}
        </span>
      </li>
    ))
  }
</ol>
