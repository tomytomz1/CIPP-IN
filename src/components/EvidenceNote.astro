---
/**
 * A labeled evidence callout. Implements the claim classification in
 * docs/04-CONTENT-EDITORIAL-SYSTEM.md on the page itself, so a reader can see what is verified,
 * what is reasoning, and what this project has not established.
 *
 * "unverified" is used for things we deliberately do NOT state: the label exists so a gap is
 * visible instead of being filled with a guess.
 *
 * The label is always visible text; the icon and color only reinforce it (color is never the
 * sole means of conveying the classification). Notes are never collapsed.
 */
interface Props {
  kind: 'fact' | 'inference' | 'unverified';
  /** Optional override for the label text. */
  label?: string;
}

const { kind, label } = Astro.props;
const defaultLabels = {
  fact: 'Verified',
  inference: 'Inference',
  unverified: 'Not established',
} as const;
---

<aside class={`note note--${kind}`}>
  <span class="note__label">
    <svg class="note__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      {kind === 'fact' && <path d="M3.5 8.4 L6.6 11.3 L12.5 4.8" />}
      {kind === 'inference' && <path d="M3 4.5 H8 M3 11.5 H8 M8 4.5 Q10 4.5 10.5 8 Q11 11.5 13 11.5 M10.5 8 H13" />}
      {kind === 'unverified' && <path d="M5.8 5.9 Q6 3.6 8.1 3.6 Q10.3 3.6 10.3 5.6 Q10.3 7.2 8.1 8.2 V9.6 M8.1 12.2 V12.4" />}
    </svg>
    {label ?? defaultLabels[kind]}
  </span>
  <div class="note__body">
    <slot />
  </div>
</aside>
