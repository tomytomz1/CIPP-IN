{
  // Cloudflare Workers + Static Assets (docs/05 → Approved Stack).
  //
  // This file is the source of truth for the Worker's name, entrypoint, custom domains,
  // compatibility date, and observability. `astro build` reads it and writes the deployable
  // config to `dist/server/wrangler.json`, adding the static-assets binding for `dist/client`.
  //
  //   npm run build:production     # SITE_ENV=production build + production-mode checks
  //   npm run deploy               # wrangler deploy -c dist/server/wrangler.json
  //   npm run verify:production    # live smoke test of the deployed site
  //
  // `src/worker.ts` is a thin entrypoint: it redirects the non-canonical `www` host to the apex
  // and delegates everything else to the Astro adapter's handler.
  //
  // No D1, R2, Queue, Turnstile, or Access binding exists here, and none is provisioned.
  // Adding one is a separate, explicitly authorized phase. Do not invent resource IDs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indy-sewer-resource",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // The apex serves the site; www only ever answers with a 301 to the apex (src/worker.ts).
  //
  // These are zone ROUTES rather than Custom Domains. Both hostnames already carry proxied DNS
  // records imported from the previous registrar, and the Workers Custom Domain API refuses to
  // replace externally managed records (error 100117) even with its override flags. A route on a
  // proxied record intercepts every request at the edge, so the old parking origin is never
  // contacted. Converting to Custom Domains later only requires deleting those two parking
  // records (apex A, www CNAME) first; the MX and SPF records for email forwarding are untouched
  // either way.
  "routes": [
    { "pattern": "indysewerresource.com/*", "zone_name": "indysewerresource.com" },
    { "pattern": "www.indysewerresource.com/*", "zone_name": "indysewerresource.com" }
  ]
}
