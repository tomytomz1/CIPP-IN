# Copy to .env for local use. Never commit real values.
#
# Build environment. One of: development | preview | production.
# Missing or unknown values resolve to "development" (every page noindex).
# Only "production" can ever emit indexable pages, and only for records that pass
# the indexing gate AND have operator approval in governance/index-approvals.json.
SITE_ENV=development

# Canonical origin (https, no path). REQUIRED when SITE_ENV=production; there is no default,
# because the target domain is not yet registered. Leave empty for development/preview.
PUBLIC_SITE_ORIGIN=

# Lead intake is DISABLED. It stays disabled until legal review of consent/privacy/retention is
# complete AND the production bindings exist. Leave every value below empty; setting them locally
# does not create the Cloudflare resources, and a TEST-ONLY consent artifact is rejected in
# production (see src/lib/leads/activation.ts).
LEAD_INTAKE_ENABLED=
LEAD_LEGAL_REVIEW_REF=
LEAD_CONSENT_ARTIFACT_ID=
LEAD_CONSENT_ARTIFACT_VERSION=

# Worker bindings added when the resources are provisioned (wrangler.jsonc), not here:
#   DB (D1), LEAD_QUEUE (Queues), plus private R2 for uploads.
#
# Worker secrets are set with `wrangler secret put`, never committed:
#   TURNSTILE_SECRET_KEY, RESEND_API_KEY, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, OPENAI_API_KEY
