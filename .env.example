# Copy to .env for local use. Never commit real values.
#
# Build environment. One of: development | preview | production.
# Missing or unknown values resolve to "development" (every page noindex).
# Only "production" can ever emit indexable pages, and only for records that pass
# the indexing gate AND have operator approval in governance/index-approvals.json.
SITE_ENV=development

# Canonical origin (https, no path). REQUIRED when SITE_ENV=production; there is no default,
# because the target domain is not yet registered. Leave empty for development/preview.
PUBLIC_SITE_ORIGIN=

# Future phases (not used in Phase 2A; do not add values here). Worker secrets will be set with
# `wrangler secret put`, never committed:
#   RESEND_API_KEY, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, OPENAI_API_KEY, TURNSTILE_SECRET_KEY
